{
    "name": "phpmyadmin/phpmyadmin",
    "type": "project",
    "description": "A web interface for MySQL and MariaDB",
    "keywords": [
        "phpmyadmin",
        "mysql",
        "web"
    ],
    "homepage": "https://www.phpmyadmin.net/",
    "support": {
        "security": "https://www.phpmyadmin.net/security/",
