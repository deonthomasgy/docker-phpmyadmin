FROM princeamd/phpmyadmin@sha256:b1662a73c16939771fb43d7476d544236a22672216bce7aadc4a6e2f572e1a1d
USER root
# Fixed runtime packages; fail the build if a security version is unavailable.
RUN apt-get update \
 && apt-get install -y --no-install-recommends apt zlib1g \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' apt)" ge '3.0.4' \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' zlib1g)" ge '1:1.3.dfsg+really1.3.1-1+deb13u1' \
 && rm -rf /var/lib/apt/lists/*
USER root
